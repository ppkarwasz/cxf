<!--
    Declares the schemas cxf-core carries on its classpath, so a document importing one of them
    resolves to the bundled copy instead of being fetched over the network.

    OASISCatalogManager loads every META-INF/jax-ws-catalog.xml on the classpath, so a module adding
    its own catalog contributes to the same resolution without any of them referring to the others.

    Each schema is listed twice: by <uri> for an xs:import that names only a namespace, and by
    <system> for one that names the canonical location as its schemaLocation.
-->
<!--
    Declares the schemas this module carries on its classpath, so a document importing one of them resolves
    to the bundled copy instead of being fetched over the network.

    OASISCatalogManager loads every META-INF/jax-ws-catalog.xml it finds, so each module contributes its own
    without any of them having to refer to the others. A namespace several schemas share is deliberately not
    mapped: it cannot name one document, and which copy won would depend on classpath order.

    A schema is listed by <uri> for an xs:import naming only a namespace, and by <system> for one naming a
    location the source tree actually imports.
-->
<catalog xmlns="urn:oasis:names:tc:entity:xmlns:xml:catalog" prefer="system">
    <uri name="http://cxf.apache.org/clustering" uri="classpath:/schemas/clustering.xsd"/>
</catalog>
